{
  "name": "ai-code-evaluation-suite",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "contracts:generate": "python -m ai_code_evaluator.export_openapi && python -m ai_code_evaluator.export_typescript",
    "contracts:check": "python -m ai_code_evaluator.export_openapi --check && python -m ai_code_evaluator.export_typescript --check",
    "dashboard:dev": "npm run dev --workspace @aices/dashboard",
    "dashboard:build": "npm run build --workspace @aices/dashboard",
    "dashboard:lint": "npm run lint --workspace @aices/dashboard",
    "dashboard:typecheck": "npm run typecheck --workspace @aices/dashboard",
    "dashboard:test": "npm run test --workspace @aices/dashboard"
  },
  "devDependencies": {
    "next": "15.5.22"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "next@15.5.22": {
      "postcss": "8.5.23",
      "sharp": "0.35.0"
    }
  }
}
